DEBUG=true
SECRET_KEY=change-me-dev-only
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://agri:agri@127.0.0.1:5432/agri
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true
# Passerelle USSD/SMS de l'operateur (vide : fermee hors DEMO_MODE)
USSD_GATEWAY_KEY=
NPI_REGEX=^\d{10}$
OTP_THROTTLE_RATE=30/min
ANIP_BACKEND=mock
PAYMENT_BACKEND=fakepay
LLM_BACKEND=auto
# Passerelle LLM du réseau local (format OpenAI) : renseigner la clé suffit.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://glm-gateway.tail577250.ts.net:4000/v1
# Vide : premier modèle annoncé par la passerelle (/v1/models)
OPENAI_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=
# Adresse du serveur Claude (réseau local, ex. http://192.168.1.20:8080) ; garder https://api.anthropic.com pour l'API publique
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5
ASSISTANT_MIN_SCORE=1.0
AUDIT_RETENTION_DAYS=1825
# P1/P2 (diagnostic, langues, marché)
DIAGNOSIS_THRESHOLD=0.6
DIAGNOSIS_RETENTION_DAYS=90
LANGUAGE_OPEN_THRESHOLD=0.8
PAYMENT_MAX_XOF=500000
FAKEPAY_DELAY_S=3
# UC-24 interopérabilité (valeurs de démonstration, à remplacer)
INTEROP_KEY_XROAD=demo-xroad-key
INTEROP_KEY_SONAMA=demo-sonama-key
INTEROP_KEY_FNDA=demo-fnda-key
VERIFY_THROTTLE_RATE=30/min

# Suivi satellite : clés du client OAuth Copernicus Data Space (laisser vide : démonstration étiquetée)
# SATELLITE_BACKEND=auto
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
