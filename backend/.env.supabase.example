# Variables du conteneur (à saisir dans l'interface de l'hébergeur, jamais dans Git).
# Supabase : Project Settings > Database > Connection string > « Session pooler » (port 5432).
# Éviter le « Transaction pooler » (port 6543) : Django y pose des problèmes de curseurs côté serveur.
DATABASE_URL=postgresql://postgres.VOTRE-REF:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres
SECRET_KEY=une-longue-valeur-aleatoire-unique
DEBUG=false
DEMO_MODE=false
# Domaine de l'API puis domaine du frontend (Vercel)
ALLOWED_HOSTS=votre-api.exemple.com
CORS_ALLOWED_ORIGINS=https://votre-frontend.vercel.app
# Clés : à renseigner seulement si le service est utilisé
USSD_GATEWAY_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANIP_BACKEND=mock
PAYMENT_BACKEND=fakepay
# Comportement du conteneur
RUN_MIGRATIONS=true
SEED_DEMO=false
WEB_CONCURRENCY=2
